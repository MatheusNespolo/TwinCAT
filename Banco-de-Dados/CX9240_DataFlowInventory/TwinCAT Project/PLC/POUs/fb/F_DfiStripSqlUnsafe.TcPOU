<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="F_DfiStripSqlUnsafe" Id="{8a95ef6f-da91-4efd-b6a5-652729a3e38e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_DfiStripSqlUnsafe : STRING(254)
VAR_INPUT
	sEntrada : STRING(254);
END_VAR
VAR
	i, n, k : INT;
	c       : BYTE;
	pIn     : POINTER TO BYTE;
	pOut    : POINTER TO BYTE;
	sRes    : STRING(254);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Filtro leve para payload_raw (auditoria): copia sIn descartando apenas
// os bytes  39 (')  34 (")  59 (;)  92 (\)  96 (`)  e qualquer byte < 16#20.
// Mantem todo o resto (chaves, dois-pontos, virgulas...). Teto em 254 chars.
// Varredura por ponteiro de bytes, no estilo de F_DfiSanitizeText.
n    := LEN(sEntrada);
pIn  := ADR(sEntrada);
pOut := ADR(sRes);
k    := 0;
FOR i := 0 TO n - 1 DO
	IF k >= 254 THEN
		EXIT;
	END_IF
	c := pIn[i];
	IF NOT ( (c = 39) OR (c = 34) OR (c = 59) OR (c = 92) OR (c = 96) OR (c < 16#20) ) THEN
		pOut[k] := c;
		k := k + 1;
	END_IF
END_FOR
pOut[k] := 0;
F_DfiStripSqlUnsafe := sRes;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>