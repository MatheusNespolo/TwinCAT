<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_DfiPayloadParser_Tests" Id="{7c07cbe2-101b-4df5-99cf-71248dd85d3a}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_DfiPayloadParser_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_Estoque_Valido();
Test_Evento_Entrega();
Test_Evento_ErroTimeout_MapeiaTipoParaDetalhe();
Test_JsonInvalido_bOkFalse();
Test_TypeAusente_bOkFalse();
Test_TypeDesconhecido_bOkFalse();
Test_Estoque_CampoFaltando_bOkFalse();
Test_Estoque_Negativo_bOkFalse();
Test_Estoque_AcimaDoMax_bOkFalse();
Test_Evento_SemCampoEvento_bOkFalse();
Test_Evento_PecaInvalida_bOkFalse();
Test_Evento_PecaAusente_Ok_PecaVazia();
Test_Evento_DetalheComAspa_bOkFalse();
Test_Evento_EventoComPontoEVirgula_bOkFalse();
Test_Evento_DetalheLongo_Truncado();
Test_Evento_PayloadRaw_Preenchido();
Test_TopicoDesconhecido_bOkFalse();
Test_StripSqlUnsafe_RemoveAspas();
]]></ST>
    </Implementation>
    <Method Name="Test_Estoque_Valido" Id="{d3fac928-6ce1-435f-9b27-f2e442c33977}">
      <Declaration><![CDATA[METHOD PRIVATE Test_Estoque_Valido
VAR
	fb  : FB_DfiPayloadParser;
	cfg : ST_DfiConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Estoque_Valido');
cfg.sTopicEstoque := 'dataflow/estoque'; cfg.nEstoqueMax := 999;
fb(bExecute := TRUE, sTopic := 'dataflow/estoque',
   sPayload := '{"type":"estoque","pecaA":4,"pecaB":5,"pecaC":6}', stConfig := cfg);
AssertTrue(fb.bOk, 'bOk');
AssertTrue(fb.eKind = E_DfiRowKind.ESTOQUE_MUDANCA, 'eKind');
AssertEquals_INT(4, fb.stEstoque.nA, 'A'); AssertEquals_INT(5, fb.stEstoque.nB, 'B'); AssertEquals_INT(6, fb.stEstoque.nC, 'C');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Evento_Entrega" Id="{ac1f5e78-ea68-4a3e-98b3-c923f538d58f}">
      <Declaration><![CDATA[METHOD PRIVATE Test_Evento_Entrega
VAR
	fb  : FB_DfiPayloadParser;
	cfg : ST_DfiConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Evento_Entrega');
cfg.sTopicEventos := 'dataflow/eventos';
fb(bExecute := TRUE, sTopic := 'dataflow/eventos',
   sPayload := '{"type":"evento","evento":"entrega","peca":"A"}', stConfig := cfg);
AssertTrue(fb.bOk, 'bOk');
AssertTrue(fb.eKind = E_DfiRowKind.EVENTO, 'eKind');
AssertEquals_STRING('entrega', fb.stEvento.sEvento, 'evento');
AssertEquals_STRING('A', fb.stEvento.sPeca, 'peca');
AssertEquals_STRING('', fb.stEvento.sDetalhe, 'sem detalhe');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Evento_ErroTimeout_MapeiaTipoParaDetalhe" Id="{4d18b78e-6a5d-4311-a445-15d705b0a663}">
      <Declaration><![CDATA[METHOD PRIVATE Test_Evento_ErroTimeout_MapeiaTipoParaDetalhe
VAR
	fb  : FB_DfiPayloadParser;
	cfg : ST_DfiConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Evento_ErroTimeout');
cfg.sTopicEventos := 'dataflow/eventos';
fb(bExecute := TRUE, sTopic := 'dataflow/eventos',
   sPayload := '{"type":"evento","evento":"erro","tipo":"timeout","peca":"B"}', stConfig := cfg);
AssertTrue(fb.bOk, 'bOk');
AssertEquals_STRING('erro', fb.stEvento.sEvento, 'evento');
AssertEquals_STRING('timeout', fb.stEvento.sDetalhe, 'tipo -> detalhe');
AssertEquals_STRING('B', fb.stEvento.sPeca, 'peca');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_JsonInvalido_bOkFalse" Id="{38d44bd6-a2e1-4f70-8fed-bb82ba80e5c4}">
      <Declaration><![CDATA[METHOD PRIVATE Test_JsonInvalido_bOkFalse
VAR
	fb  : FB_DfiPayloadParser;
	cfg : ST_DfiConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('JsonInvalido_bOkFalse');
cfg.sTopicEstoque := 'dataflow/estoque';
fb(bExecute := TRUE, sTopic := 'dataflow/estoque',
   sPayload := '{not json', stConfig := cfg);
AssertFalse(fb.bOk, 'bOk FALSE');
AssertEquals_STRING('json', fb.sParseError, 'sParseError');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_TypeAusente_bOkFalse" Id="{3d43b8cc-d621-406f-a354-6d7212be2282}">
      <Declaration><![CDATA[METHOD PRIVATE Test_TypeAusente_bOkFalse
VAR
	fb  : FB_DfiPayloadParser;
	cfg : ST_DfiConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TypeAusente_bOkFalse');
cfg.sTopicEstoque := 'dataflow/estoque';
fb(bExecute := TRUE, sTopic := 'dataflow/estoque',
   sPayload := '{"pecaA":1}', stConfig := cfg);
AssertFalse(fb.bOk, 'bOk FALSE');
AssertEquals_STRING('type', fb.sParseError, 'sParseError');
