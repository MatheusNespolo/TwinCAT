    <Method Name="Test_Estoque_Negativo_bOkFalse" Id="{5d33101a-f760-4a6c-89e2-3f9b95638262}">
      <Declaration><![CDATA[METHOD PRIVATE Test_Estoque_Negativo_bOkFalse
VAR
	fb  : FB_DfiPayloadParser;
	cfg : ST_DfiConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Estoque_Negativo_bOkFalse');
cfg.sTopicEstoque := 'dataflow/estoque'; cfg.nEstoqueMax := 999;
fb(bExecute := TRUE, sTopic := 'dataflow/estoque',
   sPayload := '{"type":"estoque","pecaA":-1,"pecaB":2,"pecaC":3}', stConfig := cfg);
