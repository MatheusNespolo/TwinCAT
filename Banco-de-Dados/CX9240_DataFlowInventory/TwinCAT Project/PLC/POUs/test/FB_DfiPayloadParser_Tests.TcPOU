    </Method>
    <Method Name="Test_Evento_PecaAusente_Ok_PecaVazia" Id="{d84d760c-f553-4ce4-95fa-0916f9eb6c08}">
      <Declaration><![CDATA[METHOD PRIVATE Test_Evento_PecaAusente_Ok_PecaVazia
VAR
	fb  : FB_DfiPayloadParser;
	cfg : ST_DfiConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Evento_PecaAusente_Ok_PecaVazia');
cfg.sTopicEventos := 'dataflow/eventos';
fb(bExecute := TRUE, sTopic := 'dataflow/eventos',
   sPayload := '{"type":"evento","evento":"inicializacao"}', stConfig := cfg);
AssertTrue(fb.bOk, 'bOk TRUE');
AssertEquals_STRING('', fb.stEvento.sPeca, 'peca vazia');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Evento_DetalheComAspa_bOkFalse" Id="{ed4cdfb5-ef22-476e-a95d-76a55553eac0}">
      <Declaration><![CDATA[METHOD PRIVATE Test_Evento_DetalheComAspa_bOkFalse
VAR
	fb  : FB_DfiPayloadParser;
	cfg : ST_DfiConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Evento_DetalheComAspa_bOkFalse');
cfg.sTopicEventos := 'dataflow/eventos';
fb(bExecute := TRUE, sTopic := 'dataflow/eventos',
   sPayload := '{"type":"evento","evento":"erro","tipo":"ti$'meout","peca":"B"}', stConfig := cfg);
AssertFalse(fb.bOk, 'bOk FALSE');
AssertEquals_STRING('sanit', fb.sParseError, 'sParseError');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Evento_EventoComPontoEVirgula_bOkFalse" Id="{3e40a953-2682-473c-910a-bb27a42b19bd}">
      <Declaration><![CDATA[METHOD PRIVATE Test_Evento_EventoComPontoEVirgula_bOkFalse
VAR
	fb  : FB_DfiPayloadParser;
	cfg : ST_DfiConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Evento_EventoComPontoEVirgula_bOkFalse');
cfg.sTopicEventos := 'dataflow/eventos';
fb(bExecute := TRUE, sTopic := 'dataflow/eventos',
   sPayload := '{"type":"evento","evento":"a;b"}', stConfig := cfg);
AssertFalse(fb.bOk, 'bOk FALSE');
AssertEquals_STRING('sanit', fb.sParseError, 'sParseError');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Evento_DetalheLongo_Truncado" Id="{7ee6bd8d-8c56-4f84-b18d-58609f03dede}">
      <Declaration><![CDATA[METHOD PRIVATE Test_Evento_DetalheLongo_Truncado
VAR
	fb      : FB_DfiPayloadParser;
	cfg     : ST_DfiConfig;
	sTipo80 : STRING(120);
	sBig    : STRING(510);
	i       : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Evento_DetalheLongo_Truncado');
cfg.sTopicEventos := 'dataflow/eventos';
sTipo80 := '';
FOR i := 1 TO 80 DO
	sTipo80 := CONCAT(sTipo80, 'x');
END_FOR
sBig := CONCAT('{"type":"evento","evento":"erro","tipo":"', CONCAT(sTipo80, '"}'));
fb(bExecute := TRUE, sTopic := 'dataflow/eventos', sPayload := sBig, stConfig := cfg);
AssertTrue(fb.bOk, 'bOk TRUE');
AssertEquals_INT(63, LEN(fb.stEvento.sDetalhe), 'detalhe truncado a 63');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Evento_PayloadRaw_Preenchido" Id="{0e591ba4-d3c3-4c52-8b5c-744ebc39ea02}">
      <Declaration><![CDATA[METHOD PRIVATE Test_Evento_PayloadRaw_Preenchido
VAR
	fb  : FB_DfiPayloadParser;
	cfg : ST_DfiConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Evento_PayloadRaw_Preenchido');
cfg.sTopicEventos := 'dataflow/eventos';
fb(bExecute := TRUE, sTopic := 'dataflow/eventos',
   sPayload := '{"type":"evento","evento":"entrega","peca":"A"}', stConfig := cfg);
AssertTrue(fb.bOk, 'bOk TRUE');
AssertEquals_STRING('{type:evento,evento:entrega,peca:A}', fb.stEvento.sPayloadRaw, 'payload_raw pos-strip');
AssertTrue(LEN(fb.stEvento.sPayloadRaw) <= 254, 'payload_raw <= 254');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_TopicoDesconhecido_bOkFalse" Id="{095d7cf4-4248-45f3-a50c-fee869b93e61}">
      <Declaration><![CDATA[METHOD PRIVATE Test_TopicoDesconhecido_bOkFalse
VAR
	fb  : FB_DfiPayloadParser;
	cfg : ST_DfiConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TopicoDesconhecido_bOkFalse');
cfg.sTopicEstoque := 'dataflow/estoque';
cfg.sTopicEventos := 'dataflow/eventos';
fb(bExecute := TRUE, sTopic := 'dataflow/sensores',
   sPayload := '{"type":"estoque","pecaA":1,"pecaB":2,"pecaC":3}', stConfig := cfg);
AssertFalse(fb.bOk, 'bOk FALSE');
AssertEquals_STRING('topic', fb.sParseError, 'sParseError');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_StripSqlUnsafe_RemoveAspas" Id="{5629e90a-d966-41f4-9d25-2630aa1db9eb}">
      <Declaration><![CDATA[METHOD PRIVATE Test_StripSqlUnsafe_RemoveAspas
VAR
	sOut : STRING(254);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('StripSqlUnsafe_RemoveAspas');
// entrada: a ' b " c ; d \ e ` f <TAB> g  -> todos os perigosos/controle somem
sOut := F_DfiStripSqlUnsafe('a$'b"c;d\e$60f$09g');
AssertEquals_STRING('abcdefg', sOut, 'strip de aspas / ; / barra / crase / controle');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
