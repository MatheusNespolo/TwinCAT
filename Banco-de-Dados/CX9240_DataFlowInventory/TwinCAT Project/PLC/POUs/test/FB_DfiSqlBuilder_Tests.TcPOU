<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_DfiSqlBuilder_Tests" Id="{caf7e750-da54-4775-94fd-d9568edef82a}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_DfiSqlBuilder_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_Build_EstoqueMudanca();
Test_Build_EstoquePeriodico_OrigemPeriodico();
Test_Build_Evento_ComPecaEDetalhe();
Test_Build_Evento_SemPeca_SemDetalhe_UsaNULL();
Test_Build_Evento_PayloadLongo_NaoTrunca();
]]></ST>
    </Implementation>
    <Method Name="Test_Build_EstoqueMudanca" Id="{f7d6aaa8-2293-4eee-a3a1-b89ece66ecf8}">
      <Declaration><![CDATA[METHOD PRIVATE Test_Build_EstoqueMudanca
VAR
	fb : FB_DfiSqlBuilder;
	linha : ST_DfiRow;
	conjunto : STRING(511);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Build_EstoqueMudanca');
linha.eKind := E_DfiRowKind.ESTOQUE_MUDANCA;
linha.sTsPlc := '2026-09-08 10:11:12.345';
linha.stEstoque.nA := 4; linha.stEstoque.nB := 5; linha.stEstoque.nC := 6;
fb.Build(linha);
AssertEquals_STRING(
  Expected := 'INSERT INTO estoque_hist (ts_plc,estoque_a,estoque_b,estoque_c,origem) VALUES ($'2026-09-08 10:11:12.345$',4,5,6,$'mudanca$');',
  Actual := conjunto, Message := 'SQL estoque mudanca');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Build_EstoquePeriodico_OrigemPeriodico" Id="{419e7162-6958-45a3-b2fc-2d516c33bae5}">
      <Declaration><![CDATA[METHOD PRIVATE Test_Build_EstoquePeriodico_OrigemPeriodico
VAR
	fb : FB_DfiSqlBuilder;
	linha : ST_DfiRow;
	conjunto : STRING(511);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Build_EstoquePeriodico');
linha.eKind := E_DfiRowKind.ESTOQUE_PERIODICO;
linha.sTsPlc := '2026-09-08 10:12:12.000';
linha.stEstoque.nA := 0; linha.stEstoque.nB := 1; linha.stEstoque.nC := 2;
fb.Build(linha);
AssertEquals_STRING(
  Expected := 'INSERT INTO estoque_hist (ts_plc,estoque_a,estoque_b,estoque_c,origem) VALUES ($'2026-09-08 10:12:12.000$',0,1,2,$'periodico$');',
  Actual := conjunto, Message := 'SQL estoque periodico');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Build_Evento_ComPecaEDetalhe" Id="{426b96ac-22e1-490c-a4c6-398cf02b20f2}">
      <Declaration><![CDATA[METHOD PRIVATE Test_Build_Evento_ComPecaEDetalhe
VAR
	fb : FB_DfiSqlBuilder;
	linha : ST_DfiRow;
	conjunto : STRING(511);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Build_Evento_ComPecaEDetalhe');
linha.eKind := E_DfiRowKind.EVENTO;
linha.sTsPlc := '2026-09-08 10:13:00.000';
linha.stEvento.sEvento := 'erro'; linha.stEvento.sPeca := 'B'; linha.stEvento.sDetalhe := 'timeout';
linha.stEvento.sPayloadRaw := '{type:evento,evento:erro}';
fb.Build(linha);
AssertEquals_STRING(
  Expected := 'INSERT INTO eventos_hist (ts_plc,evento,peca,detalhe,payload_raw) VALUES ($'2026-09-08 10:13:00.000$',$'erro$',$'B$',$'timeout$',$'{type:evento,evento:erro}$');',
  Actual := conjunto, Message := 'SQL evento completo');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Build_Evento_PayloadLongo_NaoTrunca" Id="{12b31033-c069-44e2-b4cb-5e829047e77f}">
      <Declaration><![CDATA[METHOD PRIVATE Test_Build_Evento_PayloadLongo_NaoTrunca
VAR
	fb    : FB_DfiSqlBuilder;
	linha : ST_DfiRow;
	conjunto     : STRING(511);
	sBig  : STRING(254);
	sDet  : STRING(63);
	nLen  : UINT;
	bRet  : BOOL;
	pB    : POINTER TO BYTE;
	i     : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Build_Evento_PayloadLongo_NaoTrunca');

// payload_raw no limite: 254 'x' (STRING(254)); 254 < 255 -> CONCAT ok aqui
sBig := '';
FOR i := 1 TO 254 DO
	sBig := CONCAT(sBig, 'x');
END_FOR

// detalhe no limite: 63 'y' (STRING(63))
sDet := '';
FOR i := 1 TO 63 DO
	sDet := CONCAT(sDet, 'y');
END_FOR

linha.eKind := E_DfiRowKind.EVENTO;
linha.sTsPlc := '2026-09-08 10:15:00.000';
linha.stEvento.sEvento := 'entrega';
linha.stEvento.sPeca := 'C';
linha.stEvento.sDetalhe := sDet;
linha.stEvento.sPayloadRaw := sBig;

bRet := fb.Build(stRow := linha, sCmd => conjunto, nCmdLen => nLen);

// prefixo decodificado = "INSERT INTO eventos_hist (ts_plc,evento,peca,detalhe,payload_raw) VALUES (
//   '2026-09-08 10:15:00.000','entrega','C','<63 y>','"  -> 181 bytes
// + payload 254 + "');" 3  -> 438 bytes (sem terminador)
AssertTrue(bRet, 'Build retornou TRUE para payload longo');
AssertEquals_UINT(Expected := 438, Actual := nLen, Message := 'comprimento total sem truncar');

// cauda intacta: ...x  '  )  ;
pB := ADR(conjunto);
AssertTrue(pB[nLen - 1] = 16#3B, 'ultimo byte = ; (0x3B)');
AssertTrue(pB[nLen - 2] = 16#29, 'penultimo byte = ) (0x29)');
AssertTrue(pB[nLen - 3] = 16#27, 'antepenultimo byte = aspa (0x27)');
AssertTrue(pB[nLen - 4] = 16#78, 'ultimo char do payload = x (0x78)');

TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Build_Evento_SemPeca_SemDetalhe_UsaNULL" Id="{94cc0887-639f-4958-8610-44ab1b3190c0}">
      <Declaration><![CDATA[METHOD PRIVATE Test_Build_Evento_SemPeca_SemDetalhe_UsaNULL
VAR
	fb : FB_DfiSqlBuilder;
	linha : ST_DfiRow;
	conjunto : STRING(511);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Build_Evento_SemPeca_UsaNULL');
linha.eKind := E_DfiRowKind.EVENTO;
linha.sTsPlc := '2026-09-08 10:14:00.000';
linha.stEvento.sEvento := 'inicializacao'; linha.stEvento.sPeca := ''; linha.stEvento.sDetalhe := '';
linha.stEvento.sPayloadRaw := '';
fb.Build(linha);
AssertEquals_STRING(
  Expected := 'INSERT INTO eventos_hist (ts_plc,evento,peca,detalhe,payload_raw) VALUES ($'2026-09-08 10:14:00.000$',$'inicializacao$',NULL,NULL,$'$');',
  Actual := conjunto, Message := 'peca/detalhe NULL, payload_raw string vazia');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>