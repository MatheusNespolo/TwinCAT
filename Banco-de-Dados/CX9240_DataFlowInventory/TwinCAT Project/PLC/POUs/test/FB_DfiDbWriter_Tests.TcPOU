<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_DfiDbWriter_Tests" Id="{49354fdb-87bf-4301-9321-f3075d5d6adb}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_DfiDbWriter_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
VAR CONSTANT
	// Espelham as constantes de FB_DfiDbWriter_Fake (VAR CONSTANT de FB nao e
	// visivel de fora da instancia). Manter os dois blocos em sincronia.
	SCRIPT_OK         : INT := 1;
	SCRIPT_EXEC_ERROR : INT := 2;
	SCRIPT_DB_LOST    : INT := 3;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_Sucesso_PopEContagem();
Test_ErroExecute_NaoPop_BackoffCresce();
Test_DbLost_DuranteExecute_VoltaIdle_SemPerder();
Test_PeriodicoTambemAtualizaBaseline();
]]></ST>
    </Implementation>
    <Method Name="Test_DbLost_DuranteExecute_VoltaIdle_SemPerder" Id="{4b9e809f-efbd-44b7-b1cd-e0fdefe1e856}">
      <Declaration><![CDATA[METHOD PRIVATE Test_DbLost_DuranteExecute_VoltaIdle_SemPerder
VAR
	fbBuf : FB_DfiRowBuffer := (nCapacity := 8);
	sut   : FB_DfiDbWriter_Fake;
	cfg   : ST_DfiConfig;
	linha     : ST_DfiRow;
	i     : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('DbLost_SemPerder');
sut.SetScript(SCRIPT_DB_LOST);
fbBuf.Push(linha);
FOR i := 1 TO 20 DO sut(stConfig := cfg, fbBuffer := fbBuf); END_FOR
AssertEquals_UDINT(1, fbBuf.nCount, 'linha preservada em DB_LOST');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_ErroExecute_NaoPop_BackoffCresce" Id="{6cd91532-8b0b-45b2-ba4b-8f3c2d59307b}">
      <Declaration><![CDATA[METHOD PRIVATE Test_ErroExecute_NaoPop_BackoffCresce
VAR
	fbBuf : FB_DfiRowBuffer := (nCapacity := 8);
	sut   : FB_DfiDbWriter_Fake;
	cfg   : ST_DfiConfig;
	linha     : ST_DfiRow;
	i     : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('ErroExecute_NaoPop');
sut.SetScript(SCRIPT_EXEC_ERROR);   // DoExecute retorna 2 (erro)
fbBuf.Push(linha);
FOR i := 1 TO 30 DO sut(stConfig := cfg, fbBuffer := fbBuf); END_FOR
AssertEquals_UDINT(1, fbBuf.nCount, 'linha PRESERVADA apos erro');
AssertTrue(sut.nErrors >= 1, 'nErrors incrementa');
AssertTrue(sut.eState = E_DfiWriterState.ERROR OR sut.eState = E_DfiWriterState.IDLE, 'em ERROR/backoff ou voltando');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_PeriodicoTambemAtualizaBaseline" Id="{475f70fa-1be9-4b58-8305-c4d5e443dda8}">
      <Declaration><![CDATA[METHOD PRIVATE Test_PeriodicoTambemAtualizaBaseline
VAR
	fbBuf : FB_DfiRowBuffer := (nCapacity := 8);
	sut   : FB_DfiDbWriter_Fake;
	cfg   : ST_DfiConfig; linha : ST_DfiRow; i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('PeriodicoAtualizaBaseline');
sut.SetScript(SCRIPT_OK);
linha.eKind := E_DfiRowKind.ESTOQUE_PERIODICO; linha.stEstoque.nB := 2;
fbBuf.Push(linha);
FOR i := 1 TO 20 DO sut(stConfig := cfg, fbBuffer := fbBuf); END_FOR
AssertTrue(sut.bUltimoGravadoValido, 'baseline valido apos periodico');
AssertEquals_INT(2, sut.stUltimoGravado.nB, 'baseline B=2');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Sucesso_PopEContagem" Id="{12474c00-025f-45fa-bc16-a874fc2797b8}">
      <Declaration><![CDATA[METHOD PRIVATE Test_Sucesso_PopEContagem
VAR
	fbBuf : FB_DfiRowBuffer := (nCapacity := 8);
	sut   : FB_DfiDbWriter_Fake;   // DoExecute sempre retorna 1 (ok) apos 1 ciclo "busy"
	cfg   : ST_DfiConfig;
	linha : ST_DfiRow;
	i     : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Sucesso_PopEContagem');
sut.SetScript(SCRIPT_OK);      // helper do fake
linha.eKind := E_DfiRowKind.ESTOQUE_MUDANCA; linha.stEstoque.nA := 9;
fbBuf.Push(linha);
FOR i := 1 TO 20 DO sut(stConfig := cfg, fbBuffer := fbBuf); END_FOR
AssertEquals_UDINT(0, fbBuf.nCount, 'linha removida apos sucesso');
AssertEquals_ULINT(1, sut.nRowsWritten, 'nRowsWritten=1');
AssertTrue(sut.bUltimoGravadoValido, 'dedupe baseline valido');
AssertEquals_INT(9, sut.stUltimoGravado.nA, 'dedupe baseline = ultima linha de estoque');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>