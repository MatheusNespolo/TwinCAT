<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PRG_EchoMqtt" Id="{f3a5b7d9-4c6e-4082-8b1d-7e9f2a4b6c05}" SpecialFunc="None">
    <Declaration><![CDATA[(*
    Chama o eco MQTT. É um programa à parte do PRG_Echo de propósito: usar o MQTT exige a
    TF6701 e a referência Tc3_IotBase; quem só mede ADS, OPC UA e Modbus não precisa disso.
    Para medir MQTT: importe FB_BenchMqttEcho e este programa, adicione a referência
    Tc3_IotBase, ajuste o endereço do broker abaixo e chame PRG_EchoMqtt() no MAIN.
*)
PROGRAM PRG_EchoMqtt
VAR
    fbEcho : FB_BenchMqttEcho;
    xHabilita : BOOL := TRUE; // pode ser forçado a FALSE para desconectar
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbEcho(bEnable   := xHabilita,
       sHost     := '10.199.162.30',   // o mesmo broker de [mqtt] host no config.toml
       nPort     := 1883,
       sTopicIn  := 'bench/in',
       sTopicOut := 'bench/out');
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>